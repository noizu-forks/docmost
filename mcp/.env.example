# Never commit the real value.
DOCMOST_API_URL=https://docmost.noizu.com
DOCMOST_API_KEY=replace-me
# Mutations, including VFS writes and sharing, are disabled unless set to 1.
DOCMOST_MCP_WRITES=0
# Local filesystem mount (mcp-mount over WebSocket). No token, no listener.
# The mount token is separate from DOCMOST_API_KEY.
DOCMOST_MCP_MOUNT_TOKEN=
DOCMOST_MCP_MOUNT_PORT=4700
