{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts",
    "tsx"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "node_modules/.+\\.js$": ["babel-jest", {"presets": [["@babel/preset-env", {"targets": {"node": "current"}}]]}],
    "^.+\\.(t|j)sx?$": ["ts-jest", {"tsconfig": {"allowJs": true}}]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!.*(nanoid|@sindresorhus[/+]slugify|@sindresorhus[/+]transliterate|escape-string-regexp|p-limit|yocto-queue|image-dimensions|uuid|marked|happy-dom))"
  ],
  "moduleNameMapper": {
    "^@docmost/db/(.*)$": "<rootDir>/../src/database/$1",
    "^@docmost/transactional/(.*)$": "<rootDir>/../src/integrations/transactional/$1",
    "^@docmost/ee/(.*)$": "<rootDir>/../src/ee/$1",
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}
